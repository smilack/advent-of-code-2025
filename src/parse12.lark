NUM: "0".."9"+

start: presents "\n" regions "\n"*

presents: present ("\n" present)*

regions: (region "\n")+

// present definitions

present: NUM ":\n" shape

shape: (ROW "\n")+

ROW: PIECE+

PIECE: "." | "#"

// tree regions

region: dimensions ":" required

dimensions: NUM "x" NUM

required: (" " NUM)+
